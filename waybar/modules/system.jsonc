{
    // ============================================================
    // SISTEMA
    // CPU + MEMORY + TEMPERATURE
    // ============================================================

    "group/system": {
        "orientation": "horizontal",

        "modules": [
            "cpu",
            "memory",
            "temperature"
        ]
    },



    // ============================================================
    // CPU
    // ============================================================

    "cpu": {
        "interval": 2,
        "format": " {usage}%",

        "states": {
            "warning": 70,
            "critical": 90
        },

        "tooltip": true,
        "tooltip-format": "CPU\nUsage: {usage}%"
    },



    // ============================================================
    // MEMÓRIA
    // ============================================================

    "memory": {
        "interval": 2,
        "format": " {percentage}%",

        "states": {
            "warning": 70,
            "critical": 90
        },

        "tooltip": true,
        "tooltip-format": "Memory\nUsed: {used:0.1f} GB\nAvailable: {avail:0.1f} GB\nUsage: {percentage}%"
    },



    // ============================================================
    // TEMPERATURE
    // ============================================================

    "temperature": {
        "interval": 5,
        "format": "{temperatureC}°C",
        "format-critical": " temperatureC}°C",

        "critical-threshold": 80,

        "tooltip": true,
        "tooltip-format": "Temperature\n{temperatureC}°C"
    },
}
