{
    // ============================================================
    // AUDIO-VIEWS
    // CAVA + MPRIS
    // ============================================================

    "group/audio-views": {
        "orientation": "horizontal",

        "modules": [
            "cava",
            "mpris"
        ]
    },



    // ============================================================
    // CAVA
    // ============================================================

    "cava": {
        "cava_config": "$HOME/.config/waybar/modules/cava.conf",
        "input_delay": 2,
        "reverse": true,
        "format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "actions": {
            "on-click-right": "mode"
        }
    },



    // ============================================================
    // MPRIS
    // ============================================================

    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "󰏤 {artist} - {title}",
        "format-stopped": "󰓛",
        "player-icons": {
            "default": "",
            "spotify": "",
            "firefox": "",
            "chromium": "",
            "mpv": "󰐹"
        },
        "status-icons": {
            "paused": "󰏤",
            "playing": "󰐊",
            "stopped": "󰓛"
        },

        "max-length": 35,

        "tooltip": true,
        "tooltip-format": "{player}\n{artist} - {title}",

        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },
}
