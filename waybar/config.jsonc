{
    // ============================================================
    // WAYBAR
    // ============================================================

    "layer": "top",
    "position": "top",

    "height": 50,
    "spacing": 0,

    "exclusive": true,
    "gtk-layer-shell": true,
    "passthrough": false,
    "fixed-center": true,


    // ============================================================
    // LAYOUT
    // ============================================================

    "modules-left": [
        "group/works",
        "mpris"
    ],

    "modules-center": [
        "wlr/taskbar"
    ],

    "modules-right": [
        "tray",
        "group/system",
        "clock",
        "group/tiny",
        "group/power"
    ],



    // ============================================================
    // WORKS
    // ============================================================

    "group/works": {
        "orientation": "horizontal",

        "modules": [
            "custom/distro",
            "hyprland/workspaces"
        ]
    },


    // ============================================================
    // DISTRO
    // ============================================================

    "custom/distro": {
        "format": "",
        "tooltip": false
    },


    // ============================================================
    // WORKSPACES
    // ============================================================

    "hyprland/workspaces": {
        "format": "{icon}",

        "all-outputs": true,
        "active-only": false,
        "sort-by-number": true,

        "on-click": "activate",
        "enable-bar-scroll": true,

        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6]
        },

        "format-icons": {
            "active": "󰮯",
            "urgent": "󰊠",
            "default": "•"
        },

        "tooltip": true,
        "tooltips": {
            "default": "Workspace {name}",
            "empty": "Workspace {name} — empty"
        }
    },


    // ============================================================
    // MÚSICA / MPRIS
    // ============================================================

    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "󰏤 {artist} - {title}",
        "format-stopped": "󰓛",
        "player-icons": {
            "default": "",
            "spotify": "",
            "firefox": "",
            "chromium": "",
            "mpv": "󰐹"
        },
        "status-icons": {
            "paused": "󰏤",
            "playing": "󰐊",
            "stopped": "󰓛"
        },

        "max-length": 35,

        "tooltip": true,
        "tooltip-format": "{player}\n{artist} - {title}",

        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },



    // ============================================================
    // CENTRO
    // ============================================================


    // ============================================================
    // TASKBAR
    // ============================================================

    "wlr/taskbar": {
        "format": " {icon}",
        "icon-size": 20,

        "all-outputs": true,
        "sort-by-app-id": true,
        "tooltip": true,

        "on-click": "activate",
        "on-click-middle": "close"
    },



    // ============================================================
    // SYSTEM TRAY
    // ============================================================

    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "show-passive-items": true,
        "expand": true,

        "tooltip": true
    },



    // ============================================================
    // SISTEMA
    // ============================================================

    "group/system": {
        "orientation": "horizontal",

        "modules": [
            "cpu",
            "memory",
            "temperature"
        ]
    },


    // ============================================================
    // CPU
    // ============================================================

    "cpu": {
        "interval": 2,
        "format": " {usage}%",

        "states": {
            "warning": 70,
            "critical": 90
        },

        "tooltip": true,
        "tooltip-format": "CPU\nUsage: {usage}%"
    },


    // ============================================================
    // MEMÓRIA
    // ============================================================

    "memory": {
        "interval": 2,
        "format": " {percentage}%",

        "states": {
            "warning": 70,
            "critical": 90
        },

        "tooltip": true,
        "tooltip-format": "Memory\nUsed: {used:0.1f} GB\nAvailable: {avail:0.1f} GB\nUsage: {percentage}%"
    },


    // ============================================================
    // TEMPERATURA
    // ============================================================

    "temperature": {
        "interval": 5,
        "format": "{temperatureC}°C",
        "format-critical": " temperatureC}°C",

        "critical-threshold": 80,

        "tooltip": true,
        "tooltip-format": "Temperature\n{temperatureC}°C"
    },


    // ============================================================
    // HORÁRIO
    // ============================================================

    "clock": {
        "interval": 1,
        "format": " {:%H:%M}",
        "format-alt": " {:%a %d/%m/%Y}",

        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },


    // ============================================================
    // ÁUDIO
    // ============================================================

    "group/tiny": {
        "orientation": "horizontal",

        "modules": [
          "wireplumber#sink",
          "wireplumber#source",
          "battery",
          "bluetooth",
          "network"
        ]
    },


    // ============================================================
    // WIREPLUMBER
    // ============================================================

    "wireplumber#sink": {
        "node-type": "Audio/Sink",

        "format": "{icon} ",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": [
                "", "", ""
            ]
        },

        "scroll-step": 5,

        "on-click": "pavucontrol",
        "on-click-right": "~/.config/waybar/scripts/volume output mute",
        "on-scroll-up": "~/.config/waybar/scripts/volume output up",
        "on-scroll-down": "~/.config/waybar/scripts/volume output down",

        "tooltip": true,
        "tooltip-format": "Volume: {volume}%"
    },

    "wireplumber#source": {
        "node-type": "Audio/Source",

        "format": "",
        "format-muted": "",

        "scroll-step": 5,

        "on-click": "pavucontrol",
        "on-click-right": "~/.config/waybar/scripts/volume input mute",
        "on-scroll-up": "~/.config/waybar/scripts/volume input up",
        "on-scroll-down": "~/.config/waybar/scripts/volume input down",

        "tooltip": true,
        "tooltip-format": "Volume: {volume}%"
    },


    // ============================================================
    // BATERIA
    // ============================================================

    "battery": {
        "interval": 10,
        "format": "{icon}",
        "format-icons": [
            "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
        ],
        "format-charging": "",
        "format-full": "󰂄",

        "states": {
            "warning": 20,
            "critical": 10
        },

        "tooltip": true,
        "tooltip-format": "Battery\nCapacity: {capacity}%",

        "on-click": "~/.config/waybar/scripts/power-profiles"
    },


    // ============================================================
    // BLUETOOTH
    // ============================================================

    "bluetooth": {
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "connected": "󰂱",
            "disabled": "󰂲",
        },

        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",

        "on-click": "blueman-manager",
        "on-click-right": "~/.config/waybar/scripts/bluetooth"
    },


    // ============================================================
    // REDE
    // ============================================================

    "network": {
        "interval": 3,

        "format-wifi": "{icon}",
        "format-ethernet": "󰌘",
        "format-disconnected": "󰤮",
        "format-icons": [
            "󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
        ],

        "tooltip": true,
        "tooltip-format-wifi": "Wi-Fi\n{essid}\nSignal: {signalStrength}%\nFrequency: {frequency} GHz\n↓ {bandwidthDownBytes}\n↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "Ethernet\n↓ {bandwidthDownBytes}\n↑ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Network disconnected",

        "on-click": "~/.config/waybar/scripts/network",
        "on-click-right": "nm-connection-editor"
    },


    // ============================================================
    // POWER
    // ============================================================

    "group/power": {
        "orientation": "horizontal",

        "modules": [
            "custom/notification",
            "custom/power"
        ]
    },


    // ============================================================
    // NOTIFICAÇÕES
    // ============================================================

    "custom/notification": {
        "exec": "swaync-client -swb",
        "return-type": "json",

        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",

            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",

            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",

            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },

        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",

        "tooltip": true,
        "escape": true
    },

    // ============================================================
    // POWER
    // ============================================================

    "custom/power": {
        "format": "⏻",

        "tooltip": true,
        "tooltip-format": "Power menu",

        "on-click": "~/.config/waybar/scripts/powermenu"
    }
}
