{
    // ============================================================
    // IMPORTS
    // ============================================================

    "include": [
        "~/.config/waybar/modules/works.jsonc",
        "~/.config/waybar/modules/audio-views.jsonc",
        "~/.config/waybar/modules/system.jsonc",
        "~/.config/waybar/modules/tiny.jsonc",
        "~/.config/waybar/modules/power.jsonc",
    ],


    // ============================================================
    // WAYBAR
    // ============================================================

    "layer": "top",
    "position": "top",

    "height": 50,
    "spacing": 0,

    "exclusive": true,
    "gtk-layer-shell": true,
    "passthrough": false,
    "fixed-center": true,


    // ============================================================
    // LAYOUT
    // ============================================================

    "modules-left": [
        "group/works",
        "group/audio-views",
    ],

    "modules-center": [
        "wlr/taskbar"
    ],

    "modules-right": [
        "tray",
        "group/system",
        "clock",
        "group/tiny",
        "group/power"
    ],



    // ============================================================
    // TASKBAR
    // ============================================================

    "wlr/taskbar": {
        "format": " {icon}",
        "icon-size": 20,

        "all-outputs": true,
        "sort-by-app-id": true,
        "tooltip": true,

        "on-click": "activate",
        "on-click-middle": "close"
    },



    // ============================================================
    // SYSTEM TRAY
    // ============================================================

    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "show-passive-items": true,
        "expand": true,

        "tooltip": true
    },



    // ============================================================
    // CLOCK
    // ============================================================

    "clock": {
        "interval": 30,
        "format": " {:%H:%M}",
        "format-alt": " {:%a %d/%m/%Y}",

        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
